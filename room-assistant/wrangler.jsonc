{
  "name": "hanjibung-room-assistant",
  "main": "worker.mjs",
  "compatibility_date": "2026-05-01",
  "workers_dev": true,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "ROOM_RATE", "namespace_id": "7821", "simple": { "limit": 10, "period": 60 } }
  ],
  "durable_objects": { "bindings": [{ "name": "ROOM_BUDGET", "class_name": "DailyBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DailyBudget"] }],
  "observability": { "enabled": false }
}
